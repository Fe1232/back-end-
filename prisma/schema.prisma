generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url = env("DATABASE_URL")
}

model User { 
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  nameStore  String 
  email      String  @unique
  key        String
  accountPro Boolean
} 

model products {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  nameProduct  String
  category     String
  costPrice    Float
  priceToSell  Float
  quantity     Int
  warningPoint Int
}